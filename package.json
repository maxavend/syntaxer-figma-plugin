{
  "name": "Syntaxer",
  "version": "2.0.1",
  "private": true,
  "description": "Generate Figma variable code syntax from naming conventions",
  "main": "code.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxavend/syntaxer-figma-plugin.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "npm run build:code && npm run build:ui",
    "build:code": "tsc -p tsconfig.json",
    "build:ui": "vite build",
    "watch": "npm run build:code -- --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('code.js',{force:true})\"",
    "lint": "eslint --ext .ts,.tsx,.js --ignore-pattern node_modules --ignore-pattern dist --ignore-pattern code.js .",
    "lint:fix": "eslint --ext .ts,.tsx,.js --ignore-pattern node_modules --ignore-pattern dist --ignore-pattern code.js --fix .",
    "test": "npm run build:code && node --test \"tests/**/*.test.mjs\"",
    "icons": "node scripts/extract-icons.mjs",
    "assets": "node scripts/render-assets.mjs",
    "release": "npm run clean && npm run build && npm run lint && npm test && npm run release:check",
    "release:check": "node scripts/check-release.mjs"
  },
  "author": "",
  "license": "",
  "devDependencies": {
    "@create-figma-plugin/ui": "4.0.3",
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "^1.117.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.4"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:@figma/figma-plugins/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "project": "./tsconfig.json"
    },
    "root": true,
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "caughtErrorsIgnorePattern": "^_"
        }
      ]
    },
    "overrides": [
      {
        "files": [
          "ui/**/*.js",
          "publishing/source/**/*.js"
        ],
        "parserOptions": {
          "project": null,
          "sourceType": "module",
          "ecmaVersion": 2022
        },
        "env": {
          "browser": true,
          "es2022": true
        },
        "extends": [
          "eslint:recommended"
        ],
        "rules": {}
      }
    ]
  },
  "dependencies": {
    "@rogieking/figui3": "11.2.2"
  }
}
